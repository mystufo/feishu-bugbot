# ===== 大模型配置 =====
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=

# ===== 禅道配置 =====
ZENTAO_BASE_URL=http://zentao.example.com
ZENTAO_USERNAME=
ZENTAO_PASSWORD=
# 默认禅道产品 ID：群名不在 group_config.json 中或私聊机器人时，bug 会创建到这个产品下
# 取值为禅道产品页面 URL 中 productID=<ID> 的数字
ZENTAO_DEFAULT_PRODUCT_ID=1

# ===== 飞书机器人配置（bugreport.py 使用） =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 提 bug 机器人的产品背景（bugreport.py 使用） =====
# 机器人收到群消息后会调用两次大模型：先判断这句话是不是 bug，再整理成结构化 bug。
# 两次提示词开头都有一段「软件背景」，由下面四个变量拼成，格式如下：
#
#   软件背景：
#   - 软件名称：{PRODUCT_NAME}
#   - 平台：{PRODUCT_PLATFORMS}
#   - 主要功能：{PRODUCT_DESCRIPTION}
#   - 用户群体：{PRODUCT_USERS}
#
# 背景越贴近实际产品，大模型判断是否为 bug、生成标题和复现步骤就越准确。
# 不配置时会使用「待测产品」等占位内容，产品相关的简短描述容易被误判为「不是 bug」。

# 产品名称，会出现在提示词和生成的 bug 描述中
PRODUCT_NAME=示例产品
# 产品运行的平台，如 Web端、iOS、Android、小程序端，多个用「和」连接
PRODUCT_PLATFORMS=Web端和小程序端
# 产品的核心功能，一两句话说明用户用它来做什么，这是四项里对判断影响最大的一项
PRODUCT_DESCRIPTION=用户可以在线创建和管理待办事项
# 会在群里提 bug 的人是谁，帮助大模型理解描述可能不够专业或不完整
PRODUCT_USERS=包括产品、UI等非专业测试人员

# 机器人在群里回复失败信息时提示联系的负责人，例如：
#   「您输入的信息没有成功解析成bug描述……如果多次输入失败，请联系{BUG_CONTACT_NAME}解决」
#   「Bug创建失败：xxx，请稍后重试或联系{BUG_CONTACT_NAME}解决」
BUG_CONTACT_NAME=管理员


# ===== GitLab MR 通知（mr_notify.py 使用） =====
# 可与上面的飞书应用相同，也可单独创建一个通知用应用
GITLAB_NOTIFY_FEISHU_APP_ID=
GITLAB_NOTIFY_FEISHU_APP_SECRET=

GITLAB_API_URL=https://gitlab.example.com/api/v4
# GitLab Webhook 的 Secret Token，留空则跳过签名校验
GITLAB_SECRET_TOKEN=
# 用于调用 GitLab API 的 Personal Access Token
GITLAB_PRIVATE_TOKEN=
# webhook 隐藏邮箱时，用 "用户名@该域名" 反查飞书用户
COMPANY_EMAIL_DOMAIN=example.com
